{
  "name": "flickr-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest --config src/tests/vitest.config.ts --silent",
    "coverage": "vitest run --coverage  --config src/tests/vitest.config.ts --silent",
    "verify:policy": "node scripts/verify-dependency-policy.mjs",
    "format": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"docs/**/*.md\" \".github/**/*.yml\" \".github/**/*.yaml\" \"package.json\" \"package-lock.json\" \"tsconfig.json\"",
    "start": "node build/index.js",
    "build": "tsc"
  },
  "author": "Floyd Kretschmar",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "express-rate-limit": "7.5.1",
    "moment": "2.30.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "20.19.8",
    "@vitest/coverage-v8": "3.2.4",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "vitest-mock-express": "2.2.0"
  },
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "npm@11.13.0"
